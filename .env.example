# --- Browser (.env) -----------------------------------------------------------
# Supabase: live founder counter, payments records, and free-tool leads.
# Run supabase/leads.sql and supabase/subscriptions.sql in the SQL editor first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PayPal Business app client ID (public). Sandbox while testing, live for launch.
VITE_PAYPAL_CLIENT_ID=

# --- Server (Supabase Edge Function secrets, NOT this file) --------------------
# Set with: supabase secrets set NAME=value
#   PAYPAL_CLIENT_ID          same as above
#   PAYPAL_CLIENT_SECRET      from the same PayPal app (keep secret!)
#   PAYPAL_API_BASE           https://api-m.sandbox.paypal.com  (test)  |  https://api-m.paypal.com  (live)
#   PAYPAL_FOUNDER_PLAN_ID    P-...  ($19/month plan)
#   PAYPAL_MEMBER_PLAN_ID     P-...  ($29/month plan)
#   PAYPAL_WEBHOOK_ID         from PayPal > your app > Webhooks
